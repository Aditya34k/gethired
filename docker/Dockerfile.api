FROM python:3.11-slim

WORKDIR /app

# Copy dependency file first — Docker caches this layer
# If pyproject.toml hasn't changed, pip install is skipped next build
COPY pyproject.toml .

# Create a minimal package structure so pip can install
RUN mkdir -p services/api services/ingestion services/agents mcp_servers/linkedin knowledge_base

# Install dependencies
RUN pip install --upgrade pip && \
    pip install -e "."

# Copy application code
COPY services/ ./services/
COPY mcp_servers/ ./mcp_servers/
COPY knowledge_base/ ./knowledge_base/

# Don't buffer stdout — logs appear immediately
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1

EXPOSE 8000

CMD ["python", "-m", "uvicorn", "services.api.main:app", "--host", "0.0.0.0", "--port", "8000"]